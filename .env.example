# =============================================================================
# AUTHENTICATION
# =============================================================================

# GitHub Personal Access Token
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_TOKEN=ghp_your_personal_access_token

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# =============================================================================
# DATABASE (SQLite)
# =============================================================================

# Path to SQLite database file (created automatically)
DATABASE_PATH=./data/argus.db

# =============================================================================
# CACHE
# =============================================================================

# How long a cached GitHub response is served without any network call (default: 60).
# Past this window the cached copy is still returned immediately while it revalidates in
# the background, so raising this trades freshness for fewer conditional requests rather
# than for speed.
CACHE_TTL=60

# =============================================================================
# GITHUB API
# =============================================================================

# Abort a GitHub request after this long (default: 30000)
# GITHUB_REQUEST_TIMEOUT_MS=30000

# Fetch the dashboard with one GraphQL query instead of ~316 REST calls (default: on).
# Set to 0 to force the REST fallback.
# DASHBOARD_GRAPHQL=1

# How much the dashboard covers
# DASHBOARD_REPO_LIMIT=15
# DASHBOARD_PRS_PER_REPO=10

# =============================================================================
# BACKGROUND PREFETCH
# =============================================================================

# Periodically warm the cache for the dashboard and the PRs you're involved in, so
# opening them is instant. PRs whose updatedAt hasn't moved are skipped, so a steady-state
# pass costs one GraphQL query plus a few requests. Set PREFETCH_ENABLED=0 to disable.
# PREFETCH_ENABLED=1
# PREFETCH_INTERVAL_MS=180000
# PREFETCH_MAX_PRS=20
# PREFETCH_CONCURRENCY=4

# =============================================================================
# DIFF RENDERING
# =============================================================================

# Above either threshold the Files tab renders lightweight shells and loads each file's
# diff on expand. The line threshold catches PRs with few files but enormous diffs.
# LAZY_DIFF_FILE_THRESHOLD=75
# LAZY_DIFF_LINE_THRESHOLD=5000

# =============================================================================
# GIT OPERATIONS
# =============================================================================

# Directory for bare git clones used by range-diff (default: /tmp/argus-git-cache)
# GIT_CACHE_DIR=/tmp/argus-git-cache
