<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/static/img/argus-dog.svg">
  <link rel="icon" type="image/png" href="/static/img/favicon.png">
  <%- include('partials/pwa') %>
  <link rel="stylesheet" href="/static/css/main.css">
  <style>
    /* An author rule that sets `display` beats the browser's own [hidden] rule, which is
       how .pulls-search would stay on screen while hidden. Filtering toggles `hidden`, so
       this has to hold for every element on the page. */
    [hidden] { display: none !important; }

    .pulls-page { max-width: 900px; margin: 0 auto; padding: 1rem; }
    .pulls-truncated {
      margin: 0 0 1rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
      color: var(--warning);
      background: var(--warning-surface);
      border: 1px solid var(--warning-border);
      border-radius: 6px;
    }
    .pulls-truncated code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      background: rgba(0, 0, 0, 0.05);
      border-radius: 4px;
      padding: 0 0.25rem;
    }

    .pulls-search { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
    .pulls-search-input {
      flex: 1;
      min-width: 0;
      padding: 0.375rem 0.625rem;
      font: inherit;
      font-size: 0.9rem;
      color: var(--fg);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 6px;
    }
    .pulls-search-input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-surface);
    }
    .pulls-search-count { color: var(--fg-muted); font-size: 0.85rem; white-space: nowrap; }

    /* The rail draws the shape of a stack. A filtered stack is no longer that shape, so
       it is not drawn while a query is active. */
    .pulls-page.is-searching .rail { display: none; }
    .pulls-page.is-searching .stack-node-row .pull-row { padding-left: 0.5rem; }

    .pulls-header { margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); }
    .pulls-header h1 { font-size: 1.25rem; margin: 0; }
    .pulls-header h1 a { color: var(--fg); text-decoration: none; }
    .pulls-header h1 a:hover { color: var(--accent); }

    .pulls-filters { margin-bottom: 1rem; display: flex; gap: 0.5rem; }
    .filter-link { padding: 0.25rem 0.75rem; color: var(--fg-muted); text-decoration: none; border: 1px solid var(--border); border-radius: 3px; font-size: 0.9rem; }
    .filter-link:hover { background: var(--surface); text-decoration: none; }
    .filter-link.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    .section-heading { font-size: 0.95rem; color: var(--fg-muted); font-weight: 600; margin: 1.25rem 0 0.5rem; }
    .section-heading:first-of-type { margin-top: 0.25rem; }

    .pulls-list { margin: 0; padding: 0; list-style: none; }
    .pull-item { position: relative; border-bottom: 1px solid var(--border-subtle); }
    .pull-item:last-child { border-bottom: none; }

    /* The PR link stretches over the whole row, so a click anywhere opens it here.
       The GitHub icon is a real link of its own and sits above that overlay. */
    .pull-link { position: absolute; inset: 0; }

    .pull-row { display: flex; gap: 0.75rem; align-items: baseline; padding: 0.625rem 0; }
    .pull-item:hover { background: var(--surface); }
    .pull-item:hover .pull-title { color: var(--accent); }
    .pull-number { color: var(--fg-muted); font-size: 0.9rem; min-width: 4em; }
    .pull-title { flex: 1; color: var(--fg); min-width: 0; }
    .pull-draft { color: var(--warning); font-size: 0.8rem; }
    .pull-author { color: var(--fg-subtle); font-size: 0.85rem; white-space: nowrap; }
    .pull-external {
      align-self: center;
      position: relative; z-index: 1;
      display: inline-flex;
      color: var(--fg-subtle);
    }
    .pull-external:hover { color: var(--accent); }
    .pull-branch {
      color: var(--fg-subtle); font-size: 0.78rem; white-space: nowrap;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      overflow: hidden; text-overflow: ellipsis; max-width: 16ch;
    }

    .pull-approved { color: var(--success); font-size: 0.8rem; font-weight: 600; white-space: nowrap; }
    /* Others' approvals: distinct from your own (lighter, outlined, not bold). */
    .pull-approved-others {
      color: var(--fg-muted); font-size: 0.8rem; white-space: nowrap;
      padding: 0.1rem 0.4rem; border: 1px solid #cdd5dd; border-radius: 999px;
    }

    /* --- Stacked-PR rail (git-log style) --- */
    .stack { margin-bottom: 1rem; }
    .stack-cap { color: var(--fg-subtle); font-size: 0.8rem; padding: 0 0 0.15rem 0.5rem; }
    .stack-nodes { list-style: none; margin: 0; padding: 0; }
    .stack-node { border-bottom: 1px solid #f2f2f2; }
    .stack-node:last-child { border-bottom: none; }

    .stack-node-row { display: flex; align-items: stretch; position: relative; }
    .stack-node-row:hover { background: var(--surface); }
    .stack-node-row:hover .pull-title { color: var(--accent); }
    .stack-node-row .pull-row { flex: 1; align-items: center; padding: 0.5rem 0.5rem 0.5rem 0; }
    /* Same stretched overlay as .pull-link, for the rail rows. */
    .stack-node-link { position: absolute; inset: 0; }

    .rail { display: flex; align-items: stretch; flex: 0 0 auto; }
    .rail-cell { position: relative; width: 22px; flex: 0 0 22px; }

    /* Vertical line segments */
    .rail-through::before,
    .rail-tee::before,
    .rail-elbow::before,
    .rail-node::before,
    .rail-node-branch::before {
      content: ''; position: absolute; left: 50%; width: 2px; margin-left: -1px; background: var(--border);
    }
    .rail-through::before { top: 0; bottom: 0; }
    .rail-tee::before { top: 0; bottom: 0; }
    .rail-elbow::before { top: 0; height: 50%; }
    .rail-node::before { top: 0; bottom: 0; }
    .rail-node.no-top::before { top: 50%; }
    .rail-node.no-bottom::before { bottom: 50%; }
    .rail-node-branch::before { top: 50%; bottom: 0; }      /* stub down to a following linear child */
    .rail-node-branch.no-bottom::before { display: none; }

    /* Horizontal stubs */
    .rail-tee::after,
    .rail-elbow::after,
    .rail-node-branch::after {
      content: ''; position: absolute; top: 50%; height: 2px; margin-top: -1px; background: var(--border);
    }
    .rail-tee::after,
    .rail-elbow::after { left: 50%; right: 0; }             /* junction -> child */
    .rail-node-branch::after { left: 0; right: 50%; }        /* child <- junction */

    /* Node dot (white halo masks the line passing behind it) */
    .dot {
      position: absolute; top: 50%; left: 50%; width: 10px; height: 10px; margin: -5px 0 0 -5px;
      border-radius: 50%; background: var(--fg-muted); box-shadow: 0 0 0 3px #fff;
    }
    .is-approved .dot { background: var(--success); }
    .is-draft .dot { background: #fff; border: 2px solid var(--fg-subtle); }
    .is-draft.is-approved .dot { border-color: var(--success); }

    .empty-state { color: var(--fg-muted); text-align: center; padding: 3rem; }

    /* Responsive */
    @media (max-width: 768px) {
      .pulls-page { padding: 0.75rem; }
      .pulls-filters { flex-wrap: wrap; }
      .pull-row { flex-wrap: wrap; gap: 0.5rem; }
      .pull-number { min-width: auto; }
      .stack-node-row .pull-row { flex-wrap: nowrap; }
    }

    @media (max-width: 480px) {
      .pulls-page { padding: 0.5rem; }
      .pulls-header h1 { font-size: 1rem; }
      .filter-link { padding: 0.25rem 0.5rem; font-size: 0.8rem; }
      .pull-row { padding: 0.5rem 0; }
      .pull-title { font-size: 0.9rem; }
      .pull-author { font-size: 0.8rem; }
      .rail-cell { width: 16px; flex-basis: 16px; }
      .pull-branch { display: none; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <nav class="nav-container">
      <a href="/dashboard" class="nav-logo"><%- include('partials/logo') %><span>Argus</span></a>
      <% if (user) { %>
        <a href="/notifications" class="nav-notifications" id="nav-notifications" title="Review requests">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 16a2 2 0 001.985-1.75c.017-.137-.097-.25-.235-.25h-3.5c-.138 0-.252.113-.235.25A2 2 0 008 16zM3 5a5 5 0 0110 0v2.947c0 .05.015.098.042.139l1.703 2.555A1.519 1.519 0 0113.482 13H2.518a1.519 1.519 0 01-1.263-2.36l1.703-2.554A.255.255 0 003 7.947V5z"/></svg>
          <span class="notification-badge hidden" id="notification-badge"></span>
        </a>
        <span class="nav-user"><%= user.login %></span>
      <% } %>
    </nav>
  </header>

  <%
    // Escape helper + shared row renderer, so the Stacks and Other sections render
    // identical PR rows without depending on EJS include path configuration.
    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    // Everything up to and including the branch name. The GitHub icon and the author
    // name come after it, in that order, in both row shapes below.
    function rowMain(pr) {
      let h = '';
      h += '<span class="pull-number">#' + pr.number + '</span>';
      h += '<span class="pull-title">' + esc(pr.title) + '</span>';
      if (pr.draft) h += '<span class="pull-draft">(draft)</span>';
      if (pr.approved) h += '<span class="pull-approved" title="You approved this PR">✓ Approved by you</span>';
      if (pr.otherApprovers && pr.otherApprovers.length > 0) {
        const others = pr.otherApprovers;
        const label = others.length === 1 ? others[0] : others[0] + ' +' + (others.length - 1);
        h += '<span class="pull-approved-others" title="Approved by ' + esc(others.join(', ')) + '">✓ ' + esc(label) + '</span>';
      }
      if (pr.headRef) h += '<span class="pull-branch" title="' + esc(pr.headRef) + '">' + esc(pr.headRef) + '</span>';
      return h;
    }
    function rowAuthor(pr) {
      return '<span class="pull-author">' + esc(pr.user.login) + '</span>';
    }
    // Octicon link-external (octicons, MIT): the icon that says "this goes to another site".
    function externalIcon(pr, owner, repo) {
      const url = 'https://github.com/' + esc(owner) + '/' + esc(repo) + '/pull/' + pr.number;
      return '<a class="pull-external" href="' + url + '" target="_blank" rel="noopener" '
        + 'title="Open on github.com" aria-label="Open pull request #' + pr.number + ' on github.com">'
        + '<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">'
        + '<path d="M3.75 2h3.5a.75.75 0 0 1 0 1.5h-3.5a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25v-3.5a.75.75 0 0 1 1.5 0v3.5A1.75 1.75 0 0 1 12.25 14h-8.5A1.75 1.75 0 0 1 2 12.25v-8.5C2 2.784 2.784 2 3.75 2Zm6.854-1h4.146a.25.25 0 0 1 .25.25v4.146a.25.25 0 0 1-.427.177L13.03 4.03 9.28 7.78a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042l3.75-3.75-1.543-1.543A.25.25 0 0 1 10.604 1Z"/>'
        + '</svg></a>';
    }
    // The PR link stretches over the whole row (see .pull-link / .stack-node-link), so
    // it is an empty anchor; the icon carries the accessible name for this row instead.
    function prLink(owner, repo, pr, cls) {
      return '<a href="/pr/' + esc(owner) + '/' + esc(repo) + '/' + pr.number + '" class="' + cls + '"></a>';
    }
  %>

  <main class="pulls-page">
    <div class="pulls-header">
      <h1><a href="/repos/<%= owner %>/<%= repo %>/pulls"><%= owner %>/<%= repo %></a></h1>
    </div>

    <div class="pulls-filters">
      <a href="/repos/<%= owner %>/<%= repo %>/pulls?state=open" class="filter-link <%= state === 'open' ? 'active' : '' %>">Open</a>
      <a href="/repos/<%= owner %>/<%= repo %>/pulls?state=closed" class="filter-link <%= state === 'closed' ? 'active' : '' %>">Closed</a>
      <a href="/repos/<%= owner %>/<%= repo %>/pulls?state=all" class="filter-link <%= state === 'all' ? 'active' : '' %>">All</a>
    </div>

    <%# Filters the list already in the page, so it costs no request. Hidden in the markup
        and revealed by pulls.js: without JavaScript the box could do nothing, and the rest
        of this page works without it. %>
    <div class="pulls-search" id="pulls-search" hidden>
      <input type="search"
             id="pulls-search-input"
             class="pulls-search-input"
             placeholder="Filter by number or words in the title"
             aria-label="Filter pull requests by number or words in the title"
             autocomplete="off"
             spellcheck="false">
      <span class="pulls-search-count" id="pulls-search-count" aria-live="polite"></span>
    </div>

    <p class="empty-state" id="pulls-no-matches" hidden>No pull request matches your filter.</p>

    <% if (stacks.length === 0 && standalone.length === 0) { %>
      <p class="empty-state">No pull requests found.</p>
    <% } %>

    <%# The list is capped. Say so, because a silently truncated list looks exactly like a
        complete one, and the entries a cap drops are always the least recently updated. %>
    <% if (truncated) { %>
      <p class="pulls-truncated">
        Showing the <%= shown %> most recently updated pull requests. There are more.
        Raise <code>MAX_PULLS_LISTED</code> to show them.
      </p>
    <% } %>

    <% if (stacks.length > 0) { %>
      <h2 class="section-heading" data-section-heading=".stack">Stacks</h2>
      <% stacks.forEach(stack => { %>
        <div class="stack">
          <div class="stack-cap">&#9655; <%= stack.base %></div>
          <ul class="stack-nodes">
            <% stack.nodes.forEach(node => { const pr = node.pr; %>
              <li class="stack-node js-pull-entry" data-number="<%= pr.number %>" data-title="<%= pr.title %>">
                <div class="stack-node-row">
                  <span class="rail">
                    <% node.cells.forEach((cell, idx) => {
                         const isNodeCell = idx === node.cells.length - 1;
                         let cls = 'rail-cell rail-' + cell;
                         if (isNodeCell) {
                           if (node.isRoot) cls += ' no-top';
                           if (node.isTip) cls += ' no-bottom';
                           if (pr.draft) cls += ' is-draft';
                           if (pr.approved || (pr.otherApprovers && pr.otherApprovers.length > 0)) cls += ' is-approved';
                         }
                    %><span class="<%= cls %>"><% if (isNodeCell) { %><span class="dot"></span><% } %></span><% }); %>
                  </span>
                  <div class="pull-row"><%- rowMain(pr) %><%- externalIcon(pr, owner, repo) %><%- rowAuthor(pr) %></div>
                  <%- prLink(owner, repo, pr, 'stack-node-link') %>
                </div>
              </li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    <% } %>

    <% if (standalone.length > 0) { %>
      <% if (stacks.length > 0) { %>
        <h2 class="section-heading" data-section-heading=".pulls-list">Other pull requests</h2>
      <% } %>
      <ul class="pulls-list">
        <% standalone.forEach(pr => { %>
          <li class="pull-item js-pull-entry" data-number="<%= pr.number %>" data-title="<%= pr.title %>">
            <div class="pull-row"><%- rowMain(pr) %><%- externalIcon(pr, owner, repo) %><%- rowAuthor(pr) %><%- prLink(owner, repo, pr, 'pull-link') %></div>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </main>
  <script src="/static/js/pulls.js" defer></script>
  <script src="/static/js/notifications.js"></script>
</body>
</html>
